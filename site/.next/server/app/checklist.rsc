a:["$","article","tls-version",{"id":"tls-version","className":"req-item","children":[["$","h3",null,{"children":["TLS 1.1 minimum, TLS 1.2+ recommended"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"SSL must support TLS 1.1 or higher; TLS 1.2 with AES-256 and SHA-256 is recommended."}],["$","p",null,{"className":"why","children":"TLS 1.0 is below the minimum, and TLS 1.1 is deprecated everywhere else. Most managed platforms (Vercel, Cloudflare, AWS ALB with a modern policy) already refuse both."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"openssl s_client -connect app.example.com:443 -tls1_1 </dev/null 2>&1 | grep -E \"Protocol|alert\"\n# a handshake failure here is what you want"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","nginx",{"open":true,"children":[["$","summary",null,{"children":"nginx"}],["$","pre",null,{"children":"ssl_protocols TLSv1.2 TLSv1.3;\nssl_prefer_server_ciphers on;"}]]}],["$","details","AWS ALB",{"open":false,"children":[["$","summary",null,{"children":"AWS ALB"}],["$","pre",null,{"children":"Use the security policy ELBSecurityPolicy-TLS13-1-2-2021-06 (or newer) on the HTTPS listener."}]]}]]}]]]}]
b:["$","article","cache-control",{"id":"cache-control","className":"req-item","children":[["$","h3",null,{"children":["Caching disabled on sensitive pages"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"Use Cache-Control no-cache and no-store (not private) on SSL and sensitive pages."}],["$","p",null,{"className":"why","children":"`private` only stops shared caches; the browser can still store the page on disk. Anything showing QuickBooks data, tokens or account settings needs `no-store`."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"curl -sI -H \"Cookie: session=…\" https://app.example.com/dashboard | grep -i cache-control\n# expect: no-store (and no-cache)"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","Express",{"open":true,"children":[["$","summary",null,{"children":"Express"}],["$","pre",null,{"children":"app.use(['/app', '/oauth'], (req, res, next) => {\n  res.set('Cache-Control', 'no-store, no-cache, must-revalidate');\n  res.set('Pragma', 'no-cache');\n  next();\n});"}]]}],["$","details","Next.js",{"open":false,"children":[["$","summary",null,{"children":"Next.js"}],["$","pre",null,{"children":"// next.config.js\nheaders: async () => [{\n  source: '/app/:path*',\n  headers: [{ key: 'Cache-Control', value: 'no-store, no-cache, must-revalidate' }],\n}]"}]]}],["$","details","Django",{"open":false,"children":[["$","summary",null,{"children":"Django"}],["$","pre",null,{"children":"from django.views.decorators.cache import never_cache\n\n@never_cache\ndef dashboard(request): ..."}]]}]]}]]]}]
c:["$","article","http-methods",{"id":"http-methods","className":"req-item","children":[["$","h3",null,{"children":["TRACE and unused HTTP methods disabled"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"The web server must disable TRACE and other HTTP methods that are not used."}],["$","p",null,{"className":"why","children":"TRACE echoes the request back, including headers, which enables cross-site tracing. Turn off any method your app does not serve."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"curl -si -X TRACE https://app.example.com/ | head -1\n# expect 405 or 501, not 200"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","nginx",{"open":true,"children":[["$","summary",null,{"children":"nginx"}],["$","pre",null,{"children":"if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {\n  return 405;\n}"}]]}],["$","details","Apache",{"open":false,"children":[["$","summary",null,{"children":"Apache"}],["$","pre",null,{"children":"TraceEnable off"}]]}]]}]]]}]
d:["$","article","patching-logging",{"id":"patching-logging","className":"req-item","children":[["$","h3",null,{"children":["Patches current; no credential or QuickBooks data logging"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"OS, web server and app server patches must be current. Never log user credentials or QuickBooks data."}],["$","p",null,{"className":"why","children":"Logs are often shipped to third-party services and kept for a long time. A logged refresh token is a working credential to a customer’s books."}],"$undefined",[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","Node",{"open":true,"children":[["$","summary",null,{"children":"Node"}],["$","pre",null,{"children":"// log a fingerprint, never the token\nlogger.info({ realm: hash(realmId), tokenTail: token.refresh_token.slice(-4) }, 'token refreshed');"}]]}]]}]]]}]
e:["$","section","attacks",{"id":"attacks","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"Attack vulnerabilities"}],[["$","article","csrf",{"id":"csrf","className":"req-item","children":[["$","h3",null,{"children":["Cross-Site Request Forgery protection"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"State-changing requests (including the OAuth flow) must be protected against CSRF."}],["$","p",null,{"className":"why","children":"Intuit’s sample code passes a fixed `state` value. Shipping that means anyone can make a victim’s browser connect the attacker’s QuickBooks company to the victim’s account."}],"$undefined",[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","Node (intuit-oauth)",{"open":true,"children":[["$","summary",null,{"children":"Node (intuit-oauth)"}],["$","pre",null,{"children":"// /connect\nreq.session.oauthState = crypto.randomBytes(32).toString('hex');\nres.redirect(oauthClient.authorizeUri({ scope, state: req.session.oauthState }));\n\n// /callback\nif (!req.query.state || req.query.state !== req.session.oauthState) return res.redirect('/error');\ndelete req.session.oauthState;"}]]}]]}]]]}],["$","article","xss",{"id":"xss","className":"req-item","children":[["$","h3",null,{"children":["Cross-Site Scripting (reflected & stored)"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"Validate input and encode output to prevent reflected and stored XSS."}],["$","p",null,{"className":"why","children":"Customer names, memos and line descriptions come from QuickBooks users and can contain markup. Escape them like any other user input."}],"$undefined","$undefined"]}],["$","article","injection",{"id":"injection","className":"req-item","children":[["$","h3",null,{"children":["SQL and XML injection"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"Use parameterized queries and safe XML parsing."}],["$","p",null,{"className":"why","children":"This applies to your database and also to QuickBooks query strings. A customer name like O’Brien breaks an unescaped `WHERE DisplayName = '…'` query."}],"$undefined","$undefined"]}],["$","article","auth-session",{"id":"auth-session","className":"req-item","children":[["$","h3",null,{"children":["Authentication, session management, access control"," ",["$","span",null,{"className":"chip man","children":"sign-off"}]]}],["$","p",null,{"className":"ask","children":"Authentication, session management and functional-level access control must be robust."}],["$","p",null,{"className":"why","children":"The most common real-world issue is an insecure direct object reference: changing a realmId or record id in a request shows another customer’s data. Check that ownership is enforced on every route."}],"$undefined","$undefined"]}],["$","article","open-redirect",{"id":"open-redirect","className":"req-item","children":[["$","h3",null,{"children":["Validated forwards and redirects"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"Redirect logic must be validated so it cannot be abused as an open redirect."}],["$","p",null,{"className":"why","children":"Login and OAuth flows often take a `next` or `returnTo` parameter. Only allow relative paths or an allow-list of hosts."}],"$undefined","$undefined"]}]]]}]
f:["$","section","cookies",{"id":"cookies","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"Cookies & sessions"}],[["$","article","cookie-flags",{"id":"cookie-flags","className":"req-item","children":[["$","h3",null,{"children":["Secure and HttpOnly on session cookies"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"All session cookies must set the Secure and HttpOnly attributes."}],["$","p",null,{"className":"why","children":"`Secure` keeps the cookie off plain HTTP. `HttpOnly` keeps it away from JavaScript, so an XSS bug can’t steal the session."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"curl -sI https://app.example.com/login | grep -i set-cookie"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","express-session",{"open":true,"children":[["$","summary",null,{"children":"express-session"}],["$","pre",null,{"children":"session({ cookie: { secure: true, httpOnly: true, sameSite: 'lax' }, proxy: true, ... })"}]]}],["$","details","Django",{"open":false,"children":[["$","summary",null,{"children":"Django"}],["$","pre",null,{"children":"SESSION_COOKIE_SECURE = True\nSESSION_COOKIE_HTTPONLY = True\nCSRF_COOKIE_SECURE = True"}]]}],["$","details","Rails",{"open":false,"children":[["$","summary",null,{"children":"Rails"}],["$","pre",null,{"children":"Rails.application.config.session_store :cookie_store, secure: true, httponly: true, same_site: :lax"}]]}]]}]]]}]]]}]
10:["$","section","oauth",{"id":"oauth","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"OAuth token management"}],[["$","article","token-exposure",{"id":"token-exposure","className":"req-item","children":[["$","h3",null,{"children":["Tokens never exposed or shared"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"Intuit OAuth tokens and customer-identifying information must not be exposed in the app or shared with other parties."}],["$","p",null,{"className":"why","children":"Tokens belong on the server. The browser should only ever hold an opaque session cookie, and a disconnect should revoke the tokens with Intuit."}],"$undefined","$undefined"]}],["$","article","token-encryption",{"id":"token-encryption","className":"req-item","children":[["$","h3",null,{"children":["Refresh token and realmId encrypted at rest"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"Refresh token and realmId must be encrypted (AES preferred, or 3DES) and stored in persistent storage."}],["$","p",null,{"className":"why","children":"The refresh token lasts for months and the realmId identifies the company. Both need encrypting before they reach your database or cache."}],"$undefined",[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","Node (AES-256-GCM)",{"open":true,"children":[["$","summary",null,{"children":"Node (AES-256-GCM)"}],["$","pre",null,{"children":"import crypto from 'node:crypto';\nconst key = Buffer.from(process.env.TOKEN_ENCRYPTION_KEY, 'base64'); // 32 bytes\n\nexport function encrypt(plain) {\n  const iv = crypto.randomBytes(12);\n  const c = crypto.createCipheriv('aes-256-gcm', key, iv);\n  const data = Buffer.concat([c.update(plain, 'utf8'), c.final()]);\n  return Buffer.concat([iv, c.getAuthTag(), data]).toString('base64');\n}\n\nexport function decrypt(blob) {\n  const buf = Buffer.from(blob, 'base64');\n  const d = crypto.createDecipheriv('aes-256-gcm', key, buf.subarray(0, 12));\n  d.setAuthTag(buf.subarray(12, 28));\n  return Buffer.concat([d.update(buf.subarray(28)), d.final()]).toString('utf8');\n}"}]]}],["$","details","Python (cryptography)",{"open":false,"children":[["$","summary",null,{"children":"Python (cryptography)"}],["$","pre",null,{"children":"import os, base64\nfrom cryptography.hazmat.primitives.ciphers.aead import AESGCM\n\nkey = base64.b64decode(os.environ['TOKEN_ENCRYPTION_KEY'])\n\ndef encrypt(plain: str) -> str:\n    nonce = os.urandom(12)\n    return base64.b64encode(nonce + AESGCM(key).encrypt(nonce, plain.encode(), None)).decode()"}]]}],["$","details","Rails",{"open":false,"children":[["$","summary",null,{"children":"Rails"}],["$","pre",null,{"children":"class QuickbooksConnection < ApplicationRecord\n  encrypts :refresh_token\n  encrypts :realm_id, deterministic: true\nend"}]]}]]}]]]}],["$","article","key-storage",{"id":"key-storage","className":"req-item","children":[["$","h3",null,{"children":["Encryption key kept in separate configuration"," ",["$","span",null,{"className":"chip part","children":"heuristic"}]]}],["$","p",null,{"className":"ask","children":"The AES key must be stored in a separate configuration file, not inline in code."}],["$","p",null,{"className":"why","children":"A key committed next to the ciphertext protects nothing. Load it from an environment variable, a config file outside the repo, or a secrets manager, and plan for rotation."}],"$undefined","$undefined"]}]]]}]
11:["$","section","redirect",{"id":"redirect","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"Token-endpoint redirect rule"}],[["$","article","token-endpoint-302",{"id":"token-endpoint-302","className":"req-item","children":[["$","h3",null,{"children":["Token-bearing endpoints respond with 302, not HTML"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"Endpoints receiving tokens or sensitive data in URL parameters must not return HTML; they should 302 redirect to avoid Referer leaks."}],["$","p",null,{"className":"why","children":"Intuit sends the user back to your redirect URI with `code` and `realmId` in the query string. If that URL renders a page with any third-party asset (analytics, fonts, a CDN image), the browser can send the full URL in the Referer header."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"curl -si \"https://app.example.com/oauth/callback?code=x&state=y&realmId=1\" | grep -iE \"^(HTTP|location|content-type)\"\n# expect: HTTP/1.1 302 and a location without code/realmId"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","Express",{"open":true,"children":[["$","summary",null,{"children":"Express"}],["$","pre",null,{"children":"app.get('/oauth/callback', async (req, res) => {\n  try {\n    await handleCallback(req);          // validate state, exchange code, store encrypted\n    res.redirect(302, '/app/connected');\n  } catch {\n    res.redirect(302, '/app/connect-error'); // errors redirect too\n  }\n});"}]]}]]}]]]}]]]}]
12:["$","section","data",{"id":"data","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"QuickBooks data usage"}],[["$","article","no-third-party-access",{"id":"no-third-party-access","className":"req-item","children":[["$","h3",null,{"children":["No third-party access to QuickBooks data"," ",["$","span",null,{"className":"chip man","children":"sign-off"}]]}],["$","p",null,{"className":"ask","children":"The app must not give third parties access to customer QuickBooks data, via APIs or any other means."}],["$","p",null,{"className":"why","children":"This includes indirect sharing: sending invoices to an LLM API, piping payloads into product analytics, or error trackers capturing request bodies. Review every outbound integration that sits next to QuickBooks data."}],"$undefined","$undefined"]}],["$","article","data-minimization",{"id":"data-minimization","className":"req-item","children":[["$","h3",null,{"children":["Store QuickBooks data only for functional use"," ",["$","span",null,{"className":"chip man","children":"sign-off"}]]}],["$","p",null,{"className":"ask","children":"Do not export, save or store QuickBooks data for any purpose other than the functional use of the app."}],["$","p",null,{"className":"why","children":"Keep only what the feature needs, set retention periods, and delete data when a customer disconnects."}],"$undefined","$undefined"]}]]]}]
