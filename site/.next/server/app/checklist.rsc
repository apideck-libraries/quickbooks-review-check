ion",{"href":"#token-encryption","children":"Refresh token and realmId encrypted at rest"}],["$","a","key-storage",{"href":"#key-storage","children":"Encryption key kept in separate configuration"}]]]}],["$","div","redirect",{"children":[["$","b",null,{"children":["$","a",null,{"href":"#redirect","style":{"color":"inherit"},"children":"Token-endpoint redirect rule"}]}],[["$","a","token-endpoint-302",{"href":"#token-endpoint-302","children":"Token-bearing endpoints respond with 302, not HTML"}]]]}],["$","div","data",{"children":[["$","b",null,{"children":["$","a",null,{"href":"#data","style":{"color":"inherit"},"children":"QuickBooks data usage"}]}],[["$","a","no-third-party-access",{"href":"#no-third-party-access","children":"No third-party access to QuickBooks data"}],["$","a","data-minimization",{"href":"#data-minimization","children":"Store QuickBooks data only for functional use"}]]]}]]}],["$","div",null,{"className":"guide-body","children":[["$","section","transport",{"id":"transport","className":"guide-cat","style":{"scrollMarginTop":84},"children":[["$","h2",null,{"children":"Server & transport"}],[["$","article","https-everywhere",{"id":"https-everywhere","className":"req-item","children":[["$","h3",null,{"children":["HTTPS enforced on every page"," ",["$","span",null,{"className":"chip auto","children":"automated"}]]}],["$","p",null,{"className":"ask","children":"All pages of the app must be served over HTTPS."}],["$","p",null,{"className":"why","children":"Every page, including marketing pages on the same host, should only be reachable over HTTPS. Plain HTTP should redirect permanently."}],[["$","h5",null,{"children":"Check it yourself"}],["$","pre",null,{"children":"curl -sI http://app.example.com | grep -iE \"^(HTTP|location)\"\n# expect: HTTP/1.1 301 … and location: https://…"}]],[["$","h5",null,{"children":"Fix it"}],["$","div",null,{"className":"stack","children":[["$","details","nginx",{"open":true,"children":[["$","summary",null,{"children":"nginx"}],["$","pre",null,{"children":"server {\n  listen 80;\n  server_name app.example.com;\n  return 301 https://$host$request_uri;\n}\nadd_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;"}]]}],["$","details","Express",{"open":false,"children":[["$","summary",null,{"children":"Express"}],["$","pre",null,{"children":"app.set('trust proxy', 1);\napp.use((req, res, next) =>\n  req.secure ? next() : res.redirect(301, `https://${req.headers.host}${req.url}`));"}]]}]]}]]]}],"$La","$Lb","$Lc","$Ld"]]}],"$Le","$Lf","$L10","$L11","$L12"]}]]}]
